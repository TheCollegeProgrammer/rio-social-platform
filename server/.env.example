# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/social_media_app
# HMAC secret for access tokens + CSRF tokens. Production startup FAILS if
# missing or < 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_strong_random_secret
# Token lifetimes (parseable durations: 15m, 1h, 30d)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Comma-separated allowed frontend origins (CORS, credentials: true).
# First entry is also the reset-link origin unless CLIENT_ORIGIN is set.
CORS_ORIGINS=http://localhost:5173
# Explicit origin for password-reset email links (defaults to first CORS origin)
CLIENT_ORIGIN=

# ── Rate limiting (env value wins over built-in default; blank = default) ─────
# Defaults shown as dev/test. All emit 429 { errors: [...] }.
RATE_LIMIT_MAX=           # global per-IP         (2000 dev / 500 prod / 10000 test)
AUTH_RATE_MAX=            # login, per IP+email   (15 prod / 5000 test)
REGISTER_RATE_MAX=        # register, per IP      (15 prod / 5000 test)
RESET_RATE_MAX=           # forgot+reset, per IP+email (5 prod / 5000 test)
CHANGE_PW_RATE_MAX=       # change-password, per user  (10 prod / 5000 test)
FOLLOW_RATE_MAX=          # follow toggle, per user     (300)
LIKE_RATE_MAX=            # like toggle, per user       (300)
COMMENT_RATE_MAX=         # comment create, per user    (150)
BOOKMARK_RATE_MAX=        # bookmark toggle, per user   (300)
MESSAGE_RATE_MAX=         # message send, per user      (150)
UPLOAD_RATE_MAX=          # uploads, per user           (60 prod / 5000 test)

# ── Media ─────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_SIDE=8192       # reject images wider/taller than this (px)
UPLOAD_MAX_PIXELS=40000000 # decompression-bomb cap (width × height)

# ── Password-reset email ──────────────────────────────────────────────────────
# Non-production: token delivered to gitignored outbox server/.reset-outbox.json.
# Production: set BOTH below to enable delivery via Resend HTTP API.
# The reset token is NEVER returned in an API response or logged.
RESEND_API_KEY=
RESET_EMAIL_FROM="RIO <reset@yourdomain.com>"

# ── Admin bootstrap (create-admin.js) ─────────────────────────────────────────
# Required in production; refuses known demo defaults when NODE_ENV=production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Seeds ─────────────────────────────────────────────────────────────────────
# seed*.js refuse to run in production unless FORCE_SEED=1
FORCE_SEED=
